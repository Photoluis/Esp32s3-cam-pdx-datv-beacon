CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_PM_ENABLE is not set
# i cicli DAC girano con gli interrupt mascherati
# CONFIG_ESP_INT_WDT is not set
# CONFIG_ESP_TASK_WDT_EN is not set
# console su UART0 (CH340, porta TTL)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# PSRAM 8 MB octal (ESP32-S3R8) per i fotogrammi della camera
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# come l'app di prova di esp_h264 per l'S3 (ma cache dati da 32 KB: la RAM interna serve al DMA della camera),
# stack dei task anche in PSRAM, compatibilità FreeRTOS, flash QIO
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
# newlib come la libreria precompilata openh264 di esp_h264 (il crash dei suoi mutex era però dovuto alla RAM interna
# esaurita, non a picolibc: newlib è tenuta per prudenza)
CONFIG_LIBC_NEWLIB=y
# RAM interna scarsa (128 KB vanno al banco del DAC): malloc oltre 256 byte in PSRAM (openh264), 32 KB interni riservati
# a DMA della camera e oggetti FreeRTOS. Buffer del Wi-Fi in RAM interna.
# Nota (29/10): con queste impostazioni il controllo dello stop durante la TX leggeva il driver UART in PSRAM e, con il
# riallineamento dell'orologio dei campioni, faceva saltare la fase dei simboli: ora si leggono solo registri.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# task della camera sul core 1: durante la TX il core 0 ha gli interrupt mascherati
CONFIG_CAMERA_CORE1=y
# tabella delle partizioni con la partizione "symbols" (13,9 MB)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
